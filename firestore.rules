rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Authenticated User Financial Workspace
    match /users/{userId} {
      allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Guest & Unauthenticated Device Sessions: Inputs by users are stored in Firestore
    match /guest_sessions/{deviceId} {
      allow get, list, create, update, delete: if isValidId(deviceId);

      match /{allSubcollections=**} {
        allow read, write, delete: if isValidId(deviceId);
      }
    }

    // Test connection probe
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
