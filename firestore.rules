rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Authenticated User Financial Workspace: Personal accounts, ledgers, debts, and settings
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /data/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Guest & Unauthenticated Device Sessions: Inputs by users are stored in Firestore
    match /guest_sessions/{deviceId} {
      allow read, write: if isValidId(deviceId);

      match /data/{docId} {
        allow read, write: if isValidId(deviceId);
      }

      match /{allSubcollections=**} {
        allow read, write: if isValidId(deviceId);
      }
    }

    // Test connection probe
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
