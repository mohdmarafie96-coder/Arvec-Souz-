rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Private Financial Workspace & Real-time Cloud Sync
    match /users/{userId} {
      allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;

      // Subcollections including /users/{userId}/data/financeState
      match /{allSubcollections=**} {
        allow read, write, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Test connection probe
    match /test/{docId} {
      allow read: if true;
    }
  }
}
